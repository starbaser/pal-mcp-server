{
  "name": "codex",
  "command": "codex",
  "additional_args": [
    "--skip-git-repo-check",
    "--json",
    "--dangerously-bypass-approvals-and-sandbox",
    "--enable",
    "web_search_request"
  ],
  "env": {},
  "models": {
    "codex-cli": "",
    "codex-cli-o4-mini": "o4-mini",
    "codex-cli-o3": "o3",
    "codex-cli-gpt-5.4": "gpt-5.4"
  },
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/default.txt",
      "role_args": []
    },
    "planner": {
      "prompt_path": "systemprompts/clink/default_planner.txt",
      "role_args": []
    },
    "codereviewer": {
      "prompt_path": "systemprompts/clink/codex_codereviewer.txt",
      "role_args": []
    }
  }
}
